{
    "name": "appwrite/hansi-consumer",
    "description": "Reads review jobs from Appwrite's queue and hands them to the Hansi service.",
    "type": "project",
    "license": "BSD-3-Clause",
    "require": {
        "php": ">=8.5",
        "ext-swoole": "*",
        "ext-redis": "*",
        "utopia-php/dsn": "^1.0",
        "utopia-php/nats": "^1.5",
        "utopia-php/queue": "^6.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Hansi\\Consumer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hansi\\Consumer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        },
        "sort-packages": true
    }
}
